{
  "name": "shard-db",
  "version": "1.0.5",
  "description": "High-performance embedded database for Node.js (native N-API addon)",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "install": "node-gyp-build",
    "build": "node-gyp rebuild",
    "build:release": "node-gyp rebuild --release",
    "prebuild": "prebuildify --napi --strip -t 18.0.0 -t 20.0.0 -t 22.0.0",
    "test": "bun test/basic.js"
  },
  "keywords": [
    "database",
    "embedded",
    "key-value",
    "btree",
    "native"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sayyiditow/shard-db.git"
  },
  "devDependencies": {
    "node-gyp": "^13.0.0",
    "prebuildify": "^6.0.0"
  },
  "dependencies": {
    "node-gyp-build": "^4.8.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
