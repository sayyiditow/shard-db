# Pin mkdocs-material to an exact version (Scorecard "Pinned-Dependencies").
# The previous `>=9.5` range left the docs build susceptible to a compromised
# upstream release silently shipping into our build. Bump this when you mean
# to bump it; Dependabot can also be wired up for python/pip later.
mkdocs-material==9.7.7

# Pin urllib3 to fix CodeQL vulnerabilities:
# - Decompression-bomb safeguards bypassed in streaming API
# - Sensitive headers forwarded across origins in proxied redirects
urllib3>=2.7.0

# Pin idna >=3.19 — Dependabot #4: "Specially crafted inputs to
# idna.encode() can bypass CVE-2024-3651 fix" affects every prior 3.x
# release. Pulled transitively via `requests`; we pin it directly to
# make the floor explicit.
idna>=3.19

# Pin pymdown-extensions >=11.0.1 — Dependabot #3: regression in
# pymdownx.snippets reintroduced the sibling-prefix path-traversal
# bypass that restrict_base_path was supposed to fix. 10.21.3 restores
# the safe behaviour.
pymdown-extensions>=11.0.1
